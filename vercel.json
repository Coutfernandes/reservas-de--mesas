{
  "version": 2,
  "builds": [
    {
      "src": "backend/theme_park/wsgi.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "15mb", 
        "runtime": "python3.12" 
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/theme_park/wsgi.py"
    }
  ],
  "env": {
    "PYTHONPATH": "backend"
  }
}